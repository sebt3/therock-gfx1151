diff --git a/third-party/sysdeps/linux/libdrm/CMakeLists.txt b/third-party/sysdeps/linux/libdrm/CMakeLists.txt
index 9e3b96e..5b3f4e7 100644
--- a/third-party/sysdeps/linux/libdrm/CMakeLists.txt
+++ b/third-party/sysdeps/linux/libdrm/CMakeLists.txt
@@ -81,8 +81,6 @@ add_custom_target(
   COMMAND
     "${CMAKE_COMMAND}" -E chdir "${PATCH_SOURCE_DIR}"
     "${CMAKE_COMMAND}" -E env
-      # Escaping hack: experimentally determined to persist through the layers.
-      "LDFLAGS=-Wl,-rpath='$$ORIGIN' -Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/version.lds"
       "CC=${_meson_cc}"
       "CXX=${_meson_cxx}"
       --
@@ -100,6 +98,16 @@ add_custom_target(
         -Dnouveau=disabled
         -Dradeon=disabled
         -Dvmwgfx=disabled
+        # rpath + symbol versioning (was LDFLAGS env var; escaping hack
+        # experimentally determined to persist through the layers). Moved to
+        # a meson built-in option: meson's compiler sanity check (run once
+        # per `setup`, including on `--reconfigure`) duplicates env-derived
+        # link args onto its generated sanity-check command line - harmless
+        # for most flags, but ld rejects the same --version-script tag
+        # applied twice with "duplicate version tag" (hit for real in this
+        # repo's libpciaccess sibling build, which uses the same mechanism).
+        # c_link_args goes through meson's normal single-application path.
+        "-Dc_link_args=-Wl,-rpath='$$ORIGIN' -Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/version.lds"
   COMMAND
     "${MESON_BUILD}" compile --verbose
   COMMAND
diff --git a/third-party/sysdeps/linux/libpciaccess/CMakeLists.txt b/third-party/sysdeps/linux/libpciaccess/CMakeLists.txt
index 78e8a29..0bb1a38 100644
--- a/third-party/sysdeps/linux/libpciaccess/CMakeLists.txt
+++ b/third-party/sysdeps/linux/libpciaccess/CMakeLists.txt
@@ -80,8 +80,6 @@ add_custom_target(
     # Run meson from the source directory to avoid this issue.
     "${CMAKE_COMMAND}" -E chdir "${SOURCE_DIR}"
     "${CMAKE_COMMAND}" -E env
-      # Apply symbol versioning via version.lds. RPATH is set post-install via patch_install.py.
-      "LDFLAGS=-Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/version.lds"
       "CC=${_meson_cc}"
       "CXX=${_meson_cxx}"
       --
@@ -93,6 +91,16 @@ add_custom_target(
         -Dpkgconfig.relocatable=true
         -Dlibdir=lib
         -Dzlib=disabled
+        # Apply symbol versioning via version.lds (RPATH is set post-install
+        # via patch_install.py). Passed as a meson built-in option rather
+        # than via the LDFLAGS env var: meson's compiler sanity check (run
+        # once per `setup`, including on `--reconfigure`) duplicates
+        # env-derived link args onto its generated sanity-check command
+        # line - harmless for most flags, but ld rejects the same
+        # --version-script tag applied twice with "duplicate version tag".
+        # c_link_args goes through meson's normal single-application path
+        # instead, sidestepping the duplication entirely.
+        "-Dc_link_args=-Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/version.lds"
   COMMAND
     "${MESON_BUILD}" compile --verbose
   COMMAND
